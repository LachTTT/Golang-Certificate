# .env

# PostgreSQL connection details (split into separate variables)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="bitly"
DB_SSLMODE="disable"

# Base domain for your short URLs (no trailing slash)
# e.g.: http://localhost:8080 or https://sho.rt
BASE_DOMAIN="http://localhost:8080"

# Port on which the Go server will listen
PORT="8080"
