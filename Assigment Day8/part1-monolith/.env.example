# PostgreSQL (dipakai saat menjalankan service langsung di mesin, tanpa Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=ewallet
DB_SSLMODE=disable

# Auth
JWT_SECRET=change-me-min-16-chars
JWT_TTL_MINUTES=60

# Payment session expiry (menit)
PAYMENT_TTL_MINUTES=10
